// All application data lives here: the catalogue the shop sells, the categories
// it is organised by, its reviews, and the Google Sheets connections.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps connection URLs out of the schema: migrations read them from
// prisma.config.ts, and the runtime client gets them through a driver adapter.
datasource db {
  provider = "postgresql"
}

/// One connected Google account, scoped to what it is used for.
///
/// A person may connect one account to read the catalogue and a different one to
/// write orders, so the unique key is the pair, not the user alone.
model Connection {
  id        String @id @default(cuid())

  /// Who owns this connection. The shop's own user id, and the only thing a
  /// connection is ever looked up by.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// viaSocket's `unique_identifier` for that owner — their `viasocketId`, not
  /// their user id. Stored because every viaSocket call needs it, never used to
  /// find a connection: changing it makes viaSocket treat the owner as somebody
  /// else and every connection they made appears lost.
  endUserId String
  /// "orders" | "catalogue"
  purpose   String

  /// viaSocket authentication id. Not a Google token — viaSocket holds those.
  authId   String
  /// Credential: anyone holding it can run Google Sheets as this user.
  scriptId String

  spreadsheetId    String?
  spreadsheetLabel String?
  sheetId          String?
  sheetLabel       String?

  connectedAt  DateTime  @default(now())
  lastExportAt DateTime?

  lastSyncAt    DateTime?
  lastSyncCount Int?

  /// How often to re-read the sheet, in minutes. Null means only on demand.
  /// A sheet can be edited in ways the row trigger never reports — a price
  /// corrected, a row deleted — so the shop drifts from the sheet without it.
  syncIntervalMinutes Int?

  /// The trigger subscription's own script_id — the only handle to it.
  subscriptionId String?
  /// Shared secret in the webhook URL, because viaSocket does not sign events.
  webhookToken   String?  @unique

  updatedAt DateTime @updatedAt

  @@unique([userId, purpose])
  @@index([endUserId])
  @@index([spreadsheetId, sheetId])
  @@index([userId])
}

/// Everything the shop sells.
///
/// `source` separates the two origins so a sheet import can replace its own
/// products without touching the ones that ship with the store:
/// `"seed"` came from the repository, `"sheet"` from an operator's spreadsheet.
model Product {
  id     String @id
  source String @default("seed")

  name        String
  slug        String
  category    String
  description String

  price         Float
  originalPrice Float?
  rating        Float  @default(0)
  reviewCount   Int    @default(0)

  images  String[]
  sizes   String[]
  tags    String[]
  details String[]
  /// [{ name, hex }]
  colors  Json?
  /// Free-form label → value pairs shown on the product page.
  specifications Json?

  featured   Boolean @default(false)
  newArrival Boolean @default(false)
  inStock    Boolean @default(true)

  /// Preserves the order the seed data and the spreadsheet were written in.
  position Int @default(0)

  /// Where an imported product came from, for the settings screen.
  sourceSpreadsheet String?
  sourceSheet       String?
  syncedAt          DateTime?

  reviews Review[]

  @@index([source])
  @@index([category])
  @@index([slug])
}

/// The four edits the shop is organised by. Data, not routes.
model Category {
  slug        String @id
  name        String
  description String
  tagline     String
  image       String
  position    Int    @default(0)
}

model Review {
  id        String   @id
  productId String
  author    String
  rating    Int
  date      DateTime
  title     String
  body      String   @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A person with an account.
///
/// One shop, many shoppers: `role` separates the people who buy from the ones
/// who administer the catalogue and its integrations.
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  /// scrypt, stored as `salt:hash`. Never leaves the server.
  passwordHash String
  /// "customer" | "admin"
  role         String @default("customer")

  /// The identifier handed to viaSocket for connections this user makes. Fixed
  /// at signup so it survives an email change.
  viasocketId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  cart        CartItem[]
  wishlist    WishlistItem[]
  orders      Order[]
  connections Connection[]
}

/// Server-side sessions: the browser holds an opaque token, nothing more.
///
/// Stored rather than signed so that signing out, or revoking every session,
/// actually invalidates it.
model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A line in someone's cart.
///
/// `size` and `color` default to empty rather than null because Postgres treats
/// NULLs as distinct in a unique index — with nulls, the same product could be
/// added twice and the constraint would not notice.
model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)
  size      String @default("")
  color     String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color])
  @@index([userId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

/// A placed order.
///
/// Prices are copied in rather than joined to `Product`: what someone paid must
/// not change when the catalogue does.
model Order {
  id        String @id @default(cuid())
  userId    String
  reference String @unique

  subtotal Float
  discount Float
  shipping Float
  total    Float

  /// Whether the Google Sheets export succeeded for this order.
  exported     Boolean @default(false)
  exportError  String?

  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  name     String
  category String
  image    String?
  size     String?
  color    String?
  quantity Int
  price    Float
  lineTotal Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
